{
  "name": "grdr",
  "version": "0.0.1",
  "description": "A grading tool for the Austrian school system.",
  "keywords": [
    "grading",
    "austria",
    "school",
    "teaching",
    "teacher"
  ],
  "homepage": "https://github.com/mfreimueller/grdr#readme",
  "bugs": {
    "url": "https://github.com/mfreimueller/grdr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mfreimueller/grdr.git"
  },
  "license": "UNLICENSED",
  "author": "Michael Freimüller",
  "main": "build/main/main/app.js",
  "scripts": {
    "postinstall": "npx patch-package && npm rebuild better-sqlite3",
    "prestart": "npx @electron/rebuild",
    "predev": "npx @electron/rebuild",
    "pretest": "npm rebuild better-sqlite3",
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "package": "electron-builder build"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.52.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "@types/pdfkit": "^0.17.6",
    "electron": "^42.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.1.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "better-sqlite3": "^12.10.0",
    "pdfkit": "^0.18.0",
    "vite": "^8.0.14",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  }
}
